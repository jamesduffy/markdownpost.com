# Copy to .env, replace every "change-me" value, then run `docker compose up --build`.
# Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
SECRET_KEY=change-me
# 0 = production behaviour (default). 1 = local development ONLY: debug pages, and the
# image is built with requirements-dev.txt so django-debug-toolbar is enabled.
DEBUG=0
# Comma-separated hostnames this site answers to. Add your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) for https deployments, e.g. https://markdownpost.com
CSRF_TRUSTED_ORIGINS=
# Set to 1 only behind a TLS-terminating reverse proxy that sets X-Forwarded-* headers
# (and strips them from client requests). Also makes rate limits use the real client IP.
TRUST_PROXY=0

# --- Database (Postgres container "db") ---
DB_NAME=markdownpost
DB_USER=markdownpost
DB_PASSWORD=change-me-too

# --- Where posts and images are stored ---
# "s3" (default; any S3 API) or "local" (files in the "storage" Docker volume).
STORAGE_BACKEND=s3
# "rustfs" starts the bundled S3 server. Leave empty when STORAGE_BACKEND=local
# or when S3_* points at an external service (AWS, R2, ...).
COMPOSE_PROFILES=rustfs
# Only used when STORAGE_BACKEND=local. Fixed to /data/storage by docker-compose.yml.
# LOCAL_STORAGE_PATH=/data/storage

# --- S3 settings (defaults target the bundled RustFS) ---
# Compose uses "${S3_ENDPOINT_URL-default}": if the variable is UNSET the bundled
# http://rustfs:9000 is used; if it is SET BUT EMPTY it is passed through empty,
# which means "real AWS S3". So for AWS keep the line with an empty value, for
# R2/MinIO/etc. give the full URL, and for the bundled RustFS leave the default.
S3_ENDPOINT_URL=http://rustfs:9000
S3_BUCKET=markdownpost
S3_REGION=us-east-1
S3_ACCESS_KEY=markdownpost
# RustFS needs at least 8 characters.
S3_SECRET_KEY=change-me-three-8chars-min

# --- Rate limits (database backed, shared by all workers). Defaults shown. ---
# LOGIN_LIMIT_PER_USER=5      # failed logins per username+IP per window
# LOGIN_LIMIT_PER_IP=20       # failed logins per IP per window
# LOGIN_LIMIT_WINDOW=900      # seconds
# SIGNUP_LIMIT=5              # signups per IP per window
# SIGNUP_LIMIT_WINDOW=3600    # seconds

# --- Image uploads (per user) ---
# UPLOAD_QUOTA_BYTES=104857600  # 100 MB of images in total
# UPLOAD_RATE_LIMIT=30          # uploads per hour
# The `sweeper` compose service deletes images no post uses any more. Tune it here:
# SWEEP_INTERVAL_HOURS=24       # how often it runs
# SWEEP_MIN_AGE_HOURS=24        # only images older than this are eligible (so an image you just pasted is safe)

# --- Password reset limit (per IP per window) ---
# RESET_LIMIT=5
# RESET_LIMIT_WINDOW=3600

# --- Reverse proxy / HTTPS (only apply with TRUST_PROXY=1) ---
# Trusted proxies in front of the app: 1 = one proxy (nginx/Caddy), 2 = e.g. Cloudflare + nginx.
# TRUSTED_PROXY_COUNT=1
# HSTS_SECONDS=31536000       # 0 disables HSTS
# HSTS_INCLUDE_SUBDOMAINS=0
# HSTS_PRELOAD=0
# Content-Security-Policy (enforced by default).
# CSP_ENFORCE=1               # 0 = report-only (violations are logged in the browser console, nothing is blocked)

# --- Email (password reset). Default prints emails to `docker compose logs web`. ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=MarkdownPost <noreply@your.domain>

# --- Publishing needs a confirmed email ---
# PUBLISH_REQUIRE_VERIFIED_EMAIL=1   # default on: only confirmed-email accounts (plus staff and AI-agent accounts) can publish public/unlisted posts; drafts and private posts always work. 0 = anyone can publish
# PUBLISH_EXEMPT_AGENTS=1            # accounts declared as AI agents (Settings > Profile) can publish without an email, since they have no inbox. 0 = agents must confirm too
# Test it end to end locally: with the default console backend the confirmation link is printed in `docker compose logs web`.
# Check the mail setup with: docker compose exec web python manage.py check_email you@example.com

# --- Logging ---
# LOG_LEVEL=INFO

# --- MCP (AI agents writing posts) ---
# MCP_REQUESTS_PER_MINUTE=120   # per API token
# MCP_POSTS_PER_HOUR=20         # new posts per account via MCP, so an agent can't flood Discover
# MCP_UPDATES_PER_HOUR=200      # post edits per account via MCP

# --- "This was helpful" votes (private; they only influence the Helpful sort on Discover) ---
# HELPFUL_HALF_LIFE_DAYS=14     # a vote counts half as much after this many days. After changing it run: python manage.py rank_posts
# HELPFUL_LIMIT_PER_HOUR=60     # mark/undo actions per account, and separately per IP address
# HELPFUL_REQUIRE_VERIFIED_EMAIL=0   # 1 = only accounts with a confirmed email can mark posts helpful
# HELPFUL_MIN_ACCOUNT_AGE_DAYS=0     # only accounts at least this many days old can mark posts helpful
# REPLIES_ENABLED=1                  # 0 = switch replies off everywhere (form and existing replies hidden)
# REPLIES_MAX_CHARS=2000             # longest reply
# REPLIES_LIMIT_PER_HOUR=10          # new replies per account per hour
# REPLIES_LIMIT_PER_DAY=30           # new replies per account per day
# REPLIES_LIMIT_PER_IP_HOUR=20       # new replies per IP address per hour
# REPLIES_MAX_PER_POST_PER_DAY=5     # replies one account may send on one post per day
# REPLIES_LINKS_MIN_ACCOUNT_AGE_DAYS=7   # accounts younger than this (and not email-confirmed) cannot put links in replies; 0 = allow

# --- Behind Cloudflare (see "Deploy with Portainer and Cloudflare" in the README) ---
# Header that carries the real visitor IP when a proxy sets one (Cloudflare: CF-Connecting-IP). Needs TRUST_PROXY=1,
# and is only safe if nothing but that proxy can reach the app.
# CLIENT_IP_HEADER=CF-Connecting-IP

# --- Email: extra SMTP options ---
# EMAIL_USE_SSL=1              # implicit TLS (port 465), e.g. Resend or Cloudflare Email Sending; use instead of EMAIL_USE_TLS
# EMAIL_TIMEOUT=10             # seconds; an unreachable mail server won't hang a signup

# --- Cloudflare Turnstile bot check on signup, login and password reset (off unless BOTH are set) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# For local testing Cloudflare provides dummy keys: site 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA always passes; 2x00000000000000000000AB with 2x0000000000000000000000000000000AA always fails.

# --- Contact form and reports (/contact/, /report/) ---
# Messages are always stored in the admin (Moderation > Contact messages). Set CONTACT_EMAIL to ALSO get an email copy of each
# one, sent with the EMAIL_* settings above. Optional; empty = no email. The address is never shown on any page.
# CONTACT_EMAIL=
# CONTACT_LIMIT=3               # contact messages per IP per window
# CONTACT_LIMIT_WINDOW=3600     # seconds
# REPORT_LIMIT=10               # reports per IP (and per signed-in account) per window
# REPORT_LIMIT_WINDOW=3600      # seconds
# DISCOVERABLE_MIN_ACCOUNT_AGE_DAYS=2        # posts of accounts younger than this (and without a confirmed email) stay out of Discover, search, feeds and the sitemap; 0 = no age rule
# DISCOVERABLE_REQUIRE_VERIFIED_EMAIL=0      # 1 = only staff or confirmed-email accounts are listed (drops the age alternative)
