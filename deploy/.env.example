# Settings for deploy/docker-compose.yml. Only SECRET_KEY and DB_PASSWORD are required; every other setting has a default.
#   Portainer: Stacks -> Add stack -> Repository, then enter these under "Environment variables" (use
#              "Load variables from .env file" to paste this whole file at once). Never commit real values.
#   CLI:       cp .env.example .env, fill it in, chmod 600 .env, then `docker compose up -d`.

# ---- REQUIRED ----------------------------------------------------------------------------------------------
# The image GitHub Actions builds from github.com/jamesduffy/markdownpost.com. Use :latest to follow main, or pin a
# release (e.g. :1.0.0) so upgrades happen when YOU change this line.
MARKDOWNPOST_IMAGE=ghcr.io/jamesduffy/markdownpost.com:latest

# The public address of the site (its DNS is in Cloudflare).
DOMAIN=www.markdownpost.com

# Long random strings, e.g.  openssl rand -base64 48  (any password generator works too)
SECRET_KEY=
DB_PASSWORD=

# ---- Where the app listens (for the Cloudflare Tunnel to forward to) ---------------------------------------------
# The tunnel's public hostname points at  http://<this machine's LAN IP>:WEB_PORT  (e.g. http://10.10.10.59:2255).
# WEB_BIND is the address to listen on: the LAN IP of this machine, or 0.0.0.0 for all interfaces. The default,
# 127.0.0.1, only works if cloudflared runs on this same machine. This is plain HTTP, so keep it on your LAN and
# don't port-forward it from your router.
WEB_PORT=2255
WEB_BIND=127.0.0.1

# Cloudflare tells the app each visitor's real IP in this header (used for rate limits and the Turnstile check). Safe
# because only your tunnel (and your own LAN) can reach the app. Leave it out if you don't use Cloudflare.
CLIENT_IP_HEADER=CF-Connecting-IP

# ---- Optional bundled ingress (leave empty if you already run cloudflared somewhere else) ------------------------------
# tunnel = run cloudflared inside this stack: set TUNNEL_TOKEN (Zero Trust -> Networks -> Tunnels -> your tunnel) and
#          give the public hostname the service  http://web:8000
# caddy  = Caddy on ports 80/443 with its own Let's Encrypt certificate (for a server that's reachable from the internet)
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# ---- Email (password resets and email verification) -----------------------------------------------------------------
# Without these, emails are only printed to the web container's log. Cloudflare's own Email Sending can't send to
# arbitrary people on the free plan (it needs Workers Paid), so use any SMTP provider with a free tier. Resend is a
# good fit: add your domain there, then copy the DNS records it shows (SPF/DKIM) into Cloudflare DNS as "DNS only".
# Check resend.com/pricing for the current free limits.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=1
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=<your Resend API key>
# DEFAULT_FROM_EMAIL=MarkdownPost <noreply@markdownpost.com>
#
# If you later upgrade to Cloudflare Workers Paid, its Email Sending works over SMTP too:
#   EMAIL_HOST=smtp.mx.cloudflare.net  EMAIL_PORT=465  EMAIL_USE_SSL=1  EMAIL_HOST_USER=api_token
#   EMAIL_HOST_PASSWORD=<API token with "Email Sending: Edit">   (the sender domain must be onboarded in Cloudflare)
# Receiving mail (e.g. hello@markdownpost.com forwarded to your inbox) is free with Cloudflare Email Routing.

# ---- Bot protection: Cloudflare Turnstile on signup, login and password reset (free) -----------------------------------
# Cloudflare dashboard -> Turnstile -> Add widget -> hostname www.markdownpost.com, mode Managed. Both keys must be
# set to turn it on; leave them out to leave it off.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---- Storage: Cloudflare R2 (optional; the default keeps files in a Docker volume on this server) ----------------
# R2 has a free tier (10 GB; Cloudflare may ask you to add a payment method before creating a bucket). Create a bucket,
# then R2 -> Manage API tokens -> Object Read & Write limited to that bucket. Remember to back up whichever you use.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=markdownpost
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Other optional settings -------------------------------------------------------------------------------------
# ALLOWED_HOSTS=www.markdownpost.com        # default: DOMAIN
# CSRF_TRUSTED_ORIGINS=https://www.markdownpost.com   # default: https://DOMAIN
# HSTS_SECONDS=300     # browsers are told to insist on https for this long; the default is a year. Start small
#                      # (300) on a first deployment, raise it once everything works.
# SWEEP_INTERVAL_HOURS=24      # how often unused uploaded images are removed
# SWEEP_MIN_AGE_HOURS=24
# Rate limits, upload quota, MCP limits, CSP and log level: see ../.env.example for the full list; any of them can be
# added here.
