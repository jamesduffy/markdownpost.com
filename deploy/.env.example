# Copy to .env (cp .env.example .env), fill in the four REQUIRED values, keep the file private (chmod 600 .env).

# ---- REQUIRED --------------------------------------------------------------------------------------------
# The image GitHub Actions builds from github.com/jamesduffy/markdownpost.com (ghcr.io/<owner>/<repo>:<tag>, all lowercase).
# If you forked the repo, use your own: ghcr.io/<your-user>/<your-fork>.
# Use :latest to follow main, or a release such as :1.0.0 to pin a version.
MARKDOWNPOST_IMAGE=ghcr.io/jamesduffy/markdownpost.com:latest

# The domain people will visit. Its DNS A/AAAA record must already point at this server.
DOMAIN=blog.example.com

# Generate each with:  openssl rand -base64 48   (or: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=
DB_PASSWORD=

# ---- Optional --------------------------------------------------------------------------------------------
# Defaults to DOMAIN / https://DOMAIN. Only set these for extra hostnames (comma separated).
# ALLOWED_HOSTS=blog.example.com,www.blog.example.com
# CSRF_TRUSTED_ORIGINS=https://blog.example.com,https://www.blog.example.com

# Email (verification and password-reset messages). Without it, emails are only printed to `docker compose logs web`.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=MarkdownPost <noreply@blog.example.com>

# Storage for post bodies and images. "local" (default) keeps files in a Docker volume on this server.
# For S3, R2, B2, MinIO...: STORAGE_BACKEND=s3 plus the S3_* settings below.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # leave empty (but set) for AWS S3
# S3_BUCKET=markdownpost
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Housekeeping job that deletes unused uploaded images
# SWEEP_INTERVAL_HOURS=24
# SWEEP_MIN_AGE_HOURS=24

# More knobs (rate limits, upload quota, HSTS, CSP, logging): see ../.env.example for the full list.
